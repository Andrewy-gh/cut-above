# Client build-time env (used by Vite)
CONVEX_DEPLOYMENT_URL=
CONVEX_SITE_URL=

# Optional: store both local and cloud values and switch with `pnpm convex:use:*`
CONVEX_DEPLOYMENT_URL_LOCAL=http://localhost:3210
CONVEX_SITE_URL_LOCAL=http://localhost:3211
CONVEX_DEPLOYMENT_URL_CLOUD=
CONVEX_SITE_URL_CLOUD=

# Convex runtime env (set via `pnpm dlx convex env set`)
SITE_URL=
BETTER_AUTH_SECRET=
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=
